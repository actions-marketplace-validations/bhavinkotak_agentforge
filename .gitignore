# Rust build artifacts
/target/
**/*.rs.bk

# Environment files (never commit secrets)
.env
.env.local
.env.*.local

# SQLx prepared queries — intentionally committed for offline compilation.
# Generated by `cargo sqlx prepare` run from each crate directory.
# Cache lives at crates/agentforge-db/.sqlx/ (resolved via CARGO_MANIFEST_DIR).

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Docker volumes
postgres-data/

# Logs
*.log
*.jsonl

# Compiled binaries at repo root (not crate directories)
/agentforge
/agentforge-api

# Web UI
web/node_modules/
web/dist/
web/.vite/
web/tsconfig.tsbuildinfo
