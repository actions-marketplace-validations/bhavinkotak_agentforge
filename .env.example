# AgentForge Environment Configuration
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgres://agentforge:agentforge@localhost:5432/agentforge

# Redis
REDIS_URL=redis://localhost:6379

# Server
AGENTFORGE_HOST=127.0.0.1
AGENTFORGE_PORT=8080
AGENTFORGE_LOG_LEVEL=info

# LLM API Keys (required — set at least one)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# NVIDIA NIM (free tier at build.nvidia.com — no credits required for free models)
# NVIDIA_API_KEY=nvapi-...
# AGENTFORGE_NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Ollama (local, no API key needed — https://ollama.com/download)
# Run: ollama serve && ollama pull llama3.2:3b
# AGENTFORGE_OLLAMA_BASE_URL=http://localhost:11434/v1
# AGENTFORGE_OLLAMA_MODEL=llama3.2:3b
# If the API server runs inside Docker and Ollama is on the host:
# AGENTFORGE_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# LLM Judge Configuration
# The judge model MUST differ from any agent model to prevent circular bias
# Supported providers: openai | anthropic | nvidia | ollama
AGENTFORGE_JUDGE_PROVIDER=openai
AGENTFORGE_JUDGE_MODEL=gpt-4o

# Eval Defaults
AGENTFORGE_DEFAULT_SCENARIOS=100
AGENTFORGE_MAX_SCENARIOS=2000
AGENTFORGE_DEFAULT_CONCURRENCY=10
AGENTFORGE_DEFAULT_PASS_THRESHOLD=0.85

# Optimizer
AGENTFORGE_OPTIMIZER_VARIANTS_MIN=5
AGENTFORGE_OPTIMIZER_VARIANTS_MAX=20

# Promotion Gate Defaults
AGENTFORGE_SCORE_GATE_DELTA=0.03
AGENTFORGE_REGRESSION_GATE_THRESHOLD=0.99
AGENTFORGE_STABILITY_SEEDS=3
